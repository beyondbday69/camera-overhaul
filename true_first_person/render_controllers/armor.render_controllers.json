{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.armor.chest.v1.0": {
      "arrays": {
        "materials": {
          "Array.armor_material": [
            "Material.armor",
            "Material.armor_enchanted",
            "Material.armor_leather",
            "Material.armor_leather_enchanted"
          ]
        },
        "textures": {
          "Array.armor_texture": [
            "Texture.leather",
            "Texture.chainmail",
            "Texture.iron",
            "Texture.diamond",
            "Texture.gold",
            "Texture.netherite"
          ]
        }
      },
      "geometry": "Geometry.armor.chestplate",
      "materials": [
        {
          "*": "Array.armor_material[variable.armor_material_index]"
        }
      ],
      "textures": [
        "Array.armor_texture[variable.armor_texture_index]"
      ],
      "part_visibility": [
        {
          "*": true
        }
      ]
    },
